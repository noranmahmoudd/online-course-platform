      "item": [
        {
          "name": "Register Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Response has success flag', function () { pm.expect(pm.response.json()).to.have.property('success'); });"
                ]
              }
            }
          ],
